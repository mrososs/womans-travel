# Supabase — used by the @nuxtjs/supabase module in apps/travel-frontend.
# Copy this file to `.env` and fill in your project's values.
# Find them in the Supabase dashboard: Project Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Public anon key (safe to expose to the browser).
SUPABASE_KEY=

# Storyblok — Content Delivery API (used by @storyblok/nuxt).
# Find tokens in the Storyblok space: Settings → Access Tokens.
# Use the preview token locally, the public token in production.
STORYBLOK_ACCESS_TOKEN=

# 'published' (production) or 'draft' (local dev / visual-editor preview).
STORYBLOK_VERSION=published

# 'true' only on the dedicated visual-editor preview deployment: loads the
# Storyblok bridge and relaxes frame-ancestors/x-frame-options for the editor
# iframe. Keep unset/false in production.
STORYBLOK_PREVIEW=false

# Storyblok — Management API. ONLY needed by `pnpm seed:storyblok`
# (tools/storyblok/seed.mjs); never shipped to the app. Personal access token
# from https://app.storyblok.com/#/me/account?tab=token and the numeric space id.
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_SPACE_ID=
