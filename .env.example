# Supabase — used by the @nuxtjs/supabase module in apps/travel-frontend.
# Copy this file to `.env` and fill in your project's values.
# Find them in the Supabase dashboard: Project Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Public anon key (safe to expose to the browser).
SUPABASE_KEY=

# ── Contact form email delivery (SMTP) ──────────────────────────────────────
# Credentials for the info@goldenfuturetravel.com mailbox. When these are set,
# contact submissions are emailed to CONTACT_TO (and always stored in Supabase).
# Leave blank in dev to skip sending — messages are still saved.
SMTP_HOST=
SMTP_PORT=465
# true for implicit TLS (port 465); leave blank to auto-pick by port.
SMTP_SECURE=
SMTP_USER=info@goldenfuturetravel.com
SMTP_PASS=
# Envelope "from" address (defaults to SMTP_USER).
SMTP_FROM=info@goldenfuturetravel.com
# Where contact messages are delivered.
CONTACT_TO=info@goldenfuturetravel.com

# ── Analytics (Google Analytics 4) ──────────────────────────────────────────
# GA4 measurement ID (Admin → Data streams → Web). Defaults to the production
# property when unset. The tag is only injected in production builds, so local
# development never pollutes the reports — set this to a separate test property
# if you do want to measure a staging deploy.
GA_MEASUREMENT_ID=G-PCLST8J84N

# ── Payments (Moyasar) ──────────────────────────────────────────────────────
# Saudi payment gateway (mada / Visa / Mastercard / Apple Pay / STC Pay).
# Get keys from the Moyasar dashboard → Settings → API keys. Use test keys
# (pk_test_… / sk_test_…) in development.
#
# Publishable key — safe to expose to the browser (used by Moyasar.js).
MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret key — SERVER ONLY. Never expose to the browser. Used to verify
# payments and read payment details from the Moyasar API.
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook shared secret — set the same value in Moyasar dashboard → Webhooks
# ("Secret Token"). The webhook rejects requests that don't match it.
MOYASAR_WEBHOOK_SECRET=

# ── Payments (Tabby — Pay in 4 / installments) ──────────────────────────────
# The Tabby PUBLIC key + merchant code are stored (non-sensitive) in the
# public.payment_settings table and read by the checkout page. The SECRET key +
# webhook secret live in Supabase Vault (tabby_secret_key / tabby_webhook_secret)
# and are read server-side via the get_secret() RPC — exactly like Moyasar.
#
# These env vars are only a DEV fallback used when the Supabase service-role key
# is not configured locally (so the Vault lookup is skipped). Leave blank in
# production — the Vault entries are authoritative.
# Secret key — SERVER ONLY. Used for the Checkout + Payments APIs.
TABBY_SECRET_KEY=
# Merchant code (e.g. goldenfuture) — falls back to payment_settings.
TABBY_MERCHANT_CODE=
# Webhook shared secret — sent back by Tabby on the header we registered
# (X-Webhook-Secret); the webhook rejects requests that don't match it.
TABBY_WEBHOOK_SECRET=

# ── Payments (Tamara — BNPL / installments) ─────────────────────────────────
# The Tamara PUBLIC key is stored (non-sensitive) in public.payment_settings.
# The merchant API JWT + webhook notification token live in Supabase Vault
# (tamara_api_token / tamara_notification_token) and are read server-side via
# get_secret(). These env vars are only a DEV fallback used when the Supabase
# service-role key is not configured locally. Leave blank in production.
# Merchant API JWT — SERVER ONLY. Bearer token for Checkout + Payments APIs.
TAMARA_API_TOKEN=
# Webhook notification token — HS256 secret used to verify the tamaraToken.
TAMARA_NOTIFICATION_TOKEN=

# Supabase service-role key — SERVER ONLY. Optional: enables the payment
# webhook to confirm orders when no user session is present (e.g. Moyasar
# calling the webhook directly). Find it in Project Settings → API →
# service_role. Leave blank to rely on the redirect callback only.
SUPABASE_SERVICE_KEY=
